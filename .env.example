# ---------------------------------------------------------------------------
# Followbaze environment configuration
# Copy to `.env` and adjust as needed. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
# development | production | test
APP_ENV=development
# SQLite for local development; any SQLAlchemy URL works (e.g. Postgres).
DATABASE_URL=sqlite:///./followbaze.db
# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
# Timezone used for "due today" grouping and seed data.
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
# Dev convenience: create tables on startup if migrations were not run.
# Keep false when using Alembic migrations (e.g. in Docker).
AUTO_CREATE_TABLES=true

# --- Frontend (NEXT_PUBLIC_* are inlined at build time) ----------------------
# Base URL the browser uses to reach the API. Must be reachable from the
# browser; do not use a Docker-internal hostname.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# --- Docker Compose port overrides ------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
